{
  "$schema": "../docs/theme.schema.json",
  "notex-theme": 1,
  "id": "light",
  "name": "默认浅色",
  "appearance": "light",
  "colors": {
    "bg": "#fdfdfc",
    "bg-subtle": "#f7f7f4",
    "bg-hover": "#f2f2ee",
    "bg-active": "#f0f0ec",
    "border": "#e6e6e1",
    "border-strong": "#d8d8d2",
    "fg": "#1c1c1a",
    "fg-soft": "#3a3a36",
    "fg-muted": "#6f6f6a",
    "fg-faint": "#a3a39c",
    "fg-ghost": "#c2c2bb",
    "fg-invert": "#fdfdfc",
    "accent": "#3f5a7d",
    "danger": "#9c3423",
    "warn": "#8a6d1f",
    "success": "#4b7d5b",
    "selection": "#e8e8e2",
    "shadow": "rgba(0, 0, 0, 0.16)",
    "overlay": "rgba(0, 0, 0, 0.28)",
    "syn-keyword": "#7c3aed",
    "syn-string": "#15803d",
    "syn-comment": "#8a8a84",
    "syn-number": "#b45309",
    "syn-type": "#0e7490",
    "syn-function": "#1d4ed8",
    "syn-variable": "#1c1c1a",
    "syn-operator": "#6f6f6a",
    "syn-punct": "#6f6f6a",
    "editor-selection": "#d6e2f0",
    "editor-active-line": "rgba(0, 0, 0, 0.025)"
  },
  "fonts": {
    "body": "'Helvetica Neue', Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "title": "'Newsreader', Georgia, 'Songti SC', serif"
  },
  "typography": {
    "title-weight": 900,
    "heading-weight": 600,
    "strong-weight": 600,
    "h1": 1.6,
    "h2": 1.333,
    "h3": 1.2,
    "h4": 1.067,
    "h5": 1,
    "h6": 1,
    "code-scale": 0.87
  }
}
