{
  "$schema": "../docs/theme.schema.json",
  "notex-theme": 1,
  "id": "dark",
  "name": "默认深色",
  "appearance": "dark",
  "colors": {
    "bg": "#1a1a18",
    "bg-subtle": "#212120",
    "bg-hover": "#282826",
    "bg-active": "#2f2f2c",
    "border": "#33332f",
    "border-strong": "#45453f",
    "fg": "#e8e8e2",
    "fg-soft": "#d0d0c8",
    "fg-muted": "#a0a098",
    "fg-faint": "#75756e",
    "fg-ghost": "#55554f",
    "fg-invert": "#1a1a18",
    "accent": "#8fb3d9",
    "danger": "#e08b7a",
    "warn": "#d4b062",
    "success": "#86c19b",
    "selection": "#3a3a34",
    "shadow": "rgba(0, 0, 0, 0.5)",
    "overlay": "rgba(0, 0, 0, 0.55)",
    "syn-keyword": "#c4a2f5",
    "syn-string": "#9ed9ab",
    "syn-comment": "#75756e",
    "syn-number": "#f0b464",
    "syn-type": "#7fd3e0",
    "syn-function": "#93bdf5",
    "syn-variable": "#e8e8e2",
    "syn-operator": "#a0a098",
    "syn-punct": "#a0a098",
    "editor-selection": "#3a4a5e",
    "editor-active-line": "rgba(255, 255, 255, 0.03)"
  },
  "fonts": {
    "body": "'Helvetica Neue', Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "title": "'Newsreader', Georgia, 'Songti SC', serif"
  },
  "typography": {
    "title-weight": 900,
    "heading-weight": 600,
    "strong-weight": 600,
    "h1": 1.6,
    "h2": 1.333,
    "h3": 1.2,
    "h4": 1.067,
    "h5": 1,
    "h6": 1,
    "code-scale": 0.87
  }
}
