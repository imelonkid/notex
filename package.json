    "test:session": "tsx src/core/runtime/KernelSession.test.mjs",
    "test:isolation": "tsx src/runtimes/isolation.test.mjs",
    "test:catalog": "tsx src/core/runtime/catalog.test.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:links": "tsx src/core/links.test.mjs",
    "test:paths": "tsx src/core/store/paths.test.mjs",
    "test:index": "tsx src/core/linkIndex.test.mjs",
    "test:theme": "tsx src/core/theme.test.mjs",
    "theme:docs": "tsx scripts/gen-theme-docs.mjs",
    "test:summary": "tsx src/core/noteSummary.test.mjs"
  },
  "dependencies": {
