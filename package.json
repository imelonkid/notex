    "typecheck": "tsc --noEmit",
    "test:serialize": "tsx src/core/serialize.test.mjs",
    "test:kernels": "node kernels/test-kernel.mjs java && node kernels/test-kernel.mjs python && node kernels/test-kernel.mjs js && node kernels/test-rich.mjs all",
