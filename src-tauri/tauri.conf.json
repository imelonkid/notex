{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteX",
  "version": "0.1.0",
  "identifier": "tech.notex.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteX",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": [
      "../kernels/**/*",
      "../themes/*.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "copyright": "NoteX",
    "category": "DeveloperTool"
  }
}
